#!/usr/bin/env bash
set -euo pipefail

# ── Resolve symlinks ────────────────────────────────────────────
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

# ── Constantes ──────────────────────────────────────────────────
CONFIG_FILE="$ROOT_DIR/config.ini"

# Lê valor de config.ini: _ini_get <section> <key> <fallback>
_ini_get() {
  local section="$1" key="$2" fallback="${3:-}"
  if [[ -f "$CONFIG_FILE" ]]; then
    local value
    value=$(awk -F '=' -v section="[$section]" -v key="$key" '
      $0 == section { found=1; next }
      /^\[/ { found=0 }
      found && $1 ~ "^[[:space:]]*"key"[[:space:]]*$" { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }
    ' "$CONFIG_FILE")
    if [[ -n "$value" ]]; then
      echo "$value"
      return
    fi
  fi
  echo "$fallback"
}

# Carrega configurações do config.ini (com fallbacks)
CFG_WINDOW="$(_ini_get defaults window 5m)"
CFG_QUERY_TIMEOUT="$(_ini_get defaults query_timeout 120)"
CFG_PDF_MARGIN_LEFT="$(_ini_get pdf margin_left 1.2)"
CFG_PDF_MARGIN_RIGHT="$(_ini_get pdf margin_right 1.2)"
CFG_PDF_MARGIN_TOP="$(_ini_get pdf margin_top 1.5)"
CFG_PDF_MARGIN_BOTTOM="$(_ini_get pdf margin_bottom 1.5)"
CFG_PDF_FONT_MAIN="$(_ini_get pdf font_main "DejaVu Sans")"
CFG_PDF_FONT_MONO="$(_ini_get pdf font_mono "DejaVu Sans Mono")"

INCIDENTS_BASE="$HOME/Documents/incidentes"
LEGACY_VENV="/tmp/dynatrace-incidentes-venv"
DEFAULT_VENV="${XDG_CACHE_HOME:-$HOME/.cache}/dynatrace-incidentes-venv"
PERSISTENT_VENV="${DYNATRACE_INCIDENTS_VENV:-}"

if [[ -z "$PERSISTENT_VENV" ]]; then
  if [[ -x "$LEGACY_VENV/bin/python" ]]; then
    PERSISTENT_VENV="$LEGACY_VENV"
  else
    PERSISTENT_VENV="$DEFAULT_VENV"
  fi
fi

VENV_PYTHON="$PERSISTENT_VENV/bin/python"
VENV_PIP="$PERSISTENT_VENV/bin/pip"
REQ_FILE="$ROOT_DIR/requirements.txt"
REQ_SNAPSHOT="$PERSISTENT_VENV/.requirements.snapshot"

# ── Funções utilitárias ─────────────────────────────────────────
print_header() { echo -e "\n\033[1;36m▸ $1\033[0m"; }
print_ok()     { echo -e "  \033[0;32m✔ $1\033[0m"; }
print_warn()   { echo -e "  \033[0;33m⚠ $1\033[0m"; }
print_err()    { echo -e "  \033[0;31m✘ $1\033[0m" >&2; }

# Spinner — roda em background enquanto o Python processa
SPINNER_PID=""
start_spinner() {
  local msg="${1:-Consultando Dynatrace...}"
  local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  local start=$SECONDS
  (
    while true; do
      for f in "${frames[@]}"; do
        local elapsed=$(( SECONDS - start ))
        printf "\r\033[1;33m  %s %s (%ds)\033[0m " "$f" "$msg" "$elapsed"
        sleep 0.1
      done
    done
  ) &
  SPINNER_PID=$!
  disown "$SPINNER_PID" 2>/dev/null
}

stop_spinner() {
  if [[ -n "${SPINNER_PID:-}" ]]; then
    kill "$SPINNER_PID" 2>/dev/null
    wait "$SPINNER_PID" 2>/dev/null
    SPINNER_PID=""
    printf "\r\033[K"  # limpa a linha do spinner
  fi
}

# Verifica dependências para geração de PDF (pandoc + xelatex + fvextra + fonte DejaVu)
PDF_AVAILABLE=false
_check_pdf_deps() {
  local missing=()

  if ! command -v pandoc >/dev/null 2>&1; then
    missing+=("pandoc")
  fi

  if ! command -v xelatex >/dev/null 2>&1; then
    missing+=("xelatex")
  fi

  # Verifica se fvextra.sty existe (necessário para quebra de linhas longas no PDF)
  if command -v kpsewhich >/dev/null 2>&1; then
    if ! kpsewhich fvextra.sty >/dev/null 2>&1; then
      missing+=("fvextra (texlive-latex-extra)")
    fi
  fi

  # Verifica fonte DejaVu Sans Mono
  if command -v fc-list >/dev/null 2>&1; then
    if ! fc-list "DejaVu Sans Mono" 2>/dev/null | grep -q "DejaVu"; then
      missing+=("fonts-dejavu")
    fi
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    print_warn "PDF desabilitado — faltam: ${missing[*]}"
    local os_type
    os_type="$(uname -s)"
    if [[ "$os_type" == "Darwin" ]]; then
      echo "    Instale com: brew install pandoc && brew install --cask mactex-no-gui"
    else
      echo "    Instale com: sudo apt install pandoc texlive-xetex texlive-latex-extra fonts-dejavu"
    fi
    PDF_AVAILABLE=false
    return 1
  fi

  PDF_AVAILABLE=true
  return 0
}

# Gera PDF a partir de um arquivo Markdown
_generate_pdf() {
  local md_file="$1"
  local pdf_file="${md_file%.md}.pdf"

  if [[ "$PDF_AVAILABLE" != true ]]; then
    return 1
  fi

  if pandoc "$md_file" -s -o "$pdf_file" \
    --pdf-engine=xelatex \
    -V mainfont="$CFG_PDF_FONT_MAIN" \
    -V monofont="$CFG_PDF_FONT_MONO" \
    -V geometry:"left=${CFG_PDF_MARGIN_LEFT}cm,right=${CFG_PDF_MARGIN_RIGHT}cm,top=${CFG_PDF_MARGIN_TOP}cm,bottom=${CFG_PDF_MARGIN_BOTTOM}cm" \
    -V documentclass="article" \
    --wrap=auto \
    -H <(printf '%s\n' \
      '\usepackage{fvextra}' \
      '\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines,breakanywhere,commandchars=\\\{\}}' \
      '\renewcommand{\texttt}[1]{{\small\ttfamily #1}}' \
      '\fvset{fontsize=\small,breaklines,breakanywhere}' \
    ) 2>/dev/null; then
    print_ok "PDF gerado: $pdf_file"
    return 0
  else
    print_warn "Falha ao gerar PDF de: $md_file"
    return 1
  fi
}

# ── Detecção automática de ambientes Dynatrace ──────────────────
# Busca variáveis DYNATRACE_ENV_URL_<LABEL> no ambiente corrente.
# Se não encontrar, tenta carregar de ~/.zshrc, ~/.bashrc ou ~/.oh-my-zsh/envars/dynatrace.zsh.
# Resultado: DETECTED_ENVS=("label1" "label2" ...)
DETECTED_ENVS=()

_source_dynatrace_vars() {
  # Carrega variáveis Dynatrace de arquivos de configuração do usuário (sem sobrescrever)
  local files=(
    "$HOME/.zshrc"
    "$HOME/.bashrc"
    "$HOME/.oh-my-zsh/envars/dynatrace.zsh"
  )
  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    # Extrai apenas linhas DYNATRACE_* e DTCTL_* (export ou não)
    while IFS= read -r line; do
      # Remove 'export ' prefix se existir
      line="${line#export }"
      local key="${line%%=*}"
      local val="${line#*=}"
      # Remove aspas
      val="${val%\"}"
      val="${val#\"}"
      # Só seta se ainda não estiver definida
      if [[ -n "$key" && -z "${!key:-}" && -n "$val" ]]; then
        export "$key=$val"
      fi
    done < <(grep -E '^\s*(export\s+)?(DYNATRACE_|DTCTL_)[A-Z_]+=.+' "$f" 2>/dev/null | grep -v '^\s*#')
  done
}

_detect_dynatrace_envs() {
  DETECTED_ENVS=()
  # Procura variáveis DYNATRACE_ENV_URL_<LABEL> no ambiente
  local var_name
  while IFS= read -r var_name; do
    local label="${var_name#DYNATRACE_ENV_URL_}"
    [[ -n "$label" ]] && DETECTED_ENVS+=("$label")
  done < <(env | grep -oP '^DYNATRACE_ENV_URL_[A-Z0-9_]+(?==)' 2>/dev/null || \
           env | sed -nE 's/^(DYNATRACE_ENV_URL_[A-Z0-9_]+)=.*/\1/p')
}

_load_dynatrace_env() {
  # Dado um label (por exemplo: TENANT_A, TENANT_B), exporta as variáveis genéricas a partir das sufixadas.
  local label="${1^^}"  # uppercase

  local url_var="DYNATRACE_ENV_URL_${label}"
  local platform_var="DYNATRACE_PLATFORM_TOKEN_${label}"
  local api_var="DYNATRACE_API_TOKEN_${label}"

  if [[ -n "${!url_var:-}" ]]; then
    export DYNATRACE_ENV_URL="${!url_var}"
  fi
  if [[ -n "${!platform_var:-}" ]]; then
    export DYNATRACE_PLATFORM_TOKEN="${!platform_var}"
  fi
  if [[ -n "${!api_var:-}" ]]; then
    export DYNATRACE_API_TOKEN="${!api_var}"
  fi
}

_select_dynatrace_env() {
  # Se já tem DYNATRACE_ENV_URL genérica definida e tokens OK, não faz nada
  if [[ -n "${DYNATRACE_ENV_URL:-}" && ( -n "${DYNATRACE_API_TOKEN:-}" || -n "${DYNATRACE_PLATFORM_TOKEN:-}" ) ]]; then
    return
  fi

  # Detecta ambientes disponíveis
  _detect_dynatrace_envs

  # Nenhum ambiente detectado — mostra instruções
  if [[ ${#DETECTED_ENVS[@]} -eq 0 ]]; then
    print_warn "Nenhum ambiente Dynatrace detectado (DYNATRACE_ENV_URL_<LABEL>)."
    echo ""
    echo "  Configure no seu ~/.zshrc ou ~/.oh-my-zsh/envars/dynatrace.zsh:"
    echo ""
    echo "    export DYNATRACE_ENV_URL_TENANT_A=\"https://tenant.live.dynatrace.com\""
    echo "    export DYNATRACE_PLATFORM_TOKEN_TENANT_A=\"dt0s16.<token>\""
    echo "    export DYNATRACE_API_TOKEN_TENANT_A=\"dt0c01.<token>\""
    echo ""
    return
  fi

  # Um único ambiente — carrega automaticamente
  if [[ ${#DETECTED_ENVS[@]} -eq 1 ]]; then
    local label="${DETECTED_ENVS[0]}"
    _load_dynatrace_env "$label"
    print_ok "Ambiente Dynatrace: ${label,,} (unico detectado)"
    return
  fi

  # Múltiplos ambientes — seleção interativa
  local selection="" env_label=""

  if command -v fzf >/dev/null 2>&1; then
    selection=$(for label in "${DETECTED_ENVS[@]}"; do
      local url_var="DYNATRACE_ENV_URL_${label}"
      printf "%-10s %s\n" "${label,,}" "${!url_var:-}"
    done | fzf --prompt="Selecione o ambiente Dynatrace: " --height=10 --reverse)
  fi

  # Fallback: menu numérico
  if [[ -z "$selection" ]]; then
    if ! command -v fzf >/dev/null 2>&1; then
      print_warn "fzf não encontrado (menu interativo desabilitado)."
      echo "  Instale: brew install fzf  (macOS) | sudo apt install fzf (Linux)"
      echo ""
    fi
    echo ""
    local i=1
    for label in "${DETECTED_ENVS[@]}"; do
      local url_var="DYNATRACE_ENV_URL_${label}"
      printf "  %d) %-10s %s\n" "$i" "${label,,}" "${!url_var:-}"
      ((i++))
    done
    echo ""
    read -r -p "  Escolha [1-${#DETECTED_ENVS[@]}]: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#DETECTED_ENVS[@]} )); then
      env_label="${DETECTED_ENVS[$((choice-1))]}"
    else
      print_err "Seleção inválida"
      return
    fi
  else
    env_label="$(echo "$selection" | awk '{print $1}')"
    env_label="${env_label^^}"
  fi

  if [[ -z "$env_label" ]]; then
    return
  fi

  _load_dynatrace_env "$env_label"
  print_ok "Ambiente selecionado: ${env_label,,} → ${DYNATRACE_ENV_URL:-}"
}

# ── 1. Validação de tokens ─────────────────────────────────────
check_tokens() {
  local ok=true

  print_header "Verificando tokens Dynatrace..."

  # Carrega variáveis de arquivos de config (se não estiverem no ambiente)
  _source_dynatrace_vars

  # Se não tem DYNATRACE_ENV_URL genérica, detecta e seleciona ambiente
  if [[ -z "${DYNATRACE_ENV_URL:-}" ]] || [[ -z "${DYNATRACE_API_TOKEN:-}" && -z "${DYNATRACE_PLATFORM_TOKEN:-}" ]]; then
    _select_dynatrace_env
  fi

  # DYNATRACE_ENV_URL
  if [[ -z "${DYNATRACE_ENV_URL:-}" ]]; then
    print_err "DYNATRACE_ENV_URL não configurada"
    ok=false
  else
    print_ok "DYNATRACE_ENV_URL: $DYNATRACE_ENV_URL"
