# URL base do ambiente Dynatrace (sem barra final)
DYNATRACE_ENV_URL=https://<tenant>.live.dynatrace.com

# --- Opcao 1 (recomendado): Access Token classico ---
# Crie em: https://<tenant>.live.dynatrace.com/ui/access-tokens
# Scopes necessarios: problems.read, events.read, entities.read
DYNATRACE_API_TOKEN=

# --- Opcao 2: Platform token (Bearer JWT para DQL/Grail) ---
# Crie em: https://myaccount.dynatrace.com
# Scopes: storage:events:read, storage:entities:read, storage:buckets:read
DYNATRACE_PLATFORM_TOKEN=

# Modo de autenticacao: auto | classic | dql  (padrao: auto)
# auto  = detecta automaticamente qual token/endpoint funciona
# classic = forca uso do DYNATRACE_API_TOKEN + /api/v2/problems
# dql   = forca uso do DYNATRACE_PLATFORM_TOKEN + DQL/Grail
DYNATRACE_AUTH_MODE=auto

# URLs de dashboards Dynatrace separados por virgula (opcional)
DASHBOARD_URLS=
